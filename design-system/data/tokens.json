{
  "$description": "Filmmakers System design tokens. W3C Design Tokens (DTCG) layout; colour values are CSS colour strings. The 'bootstrap' group mirrors denkungsart/bootstrap-v6-dev@bc4bcb4 (6.0.0-alpha1) and is not edited by hand. The 'filmmakers' group holds our decisions and references Bootstrap tokens only.",
  "bootstrap": {
    "color": {
      "$type": "color",
      "white": {
        "$value": "#fff"
      },
      "black": {
        "$value": "#000"
      },
      "blue": {
        "500": {
          "$value": "oklch(60% 0.24 240)"
        },
        "600": {
          "$value": "color-mix(in oklch, #000 16%, oklch(60% 0.24 240))"
        }
      },
      "orange": {
        "500": {
          "$value": "oklch(70% 0.22 52)"
        }
      }
    },
    "scale": {
      "$description": "Bootstrap builds every hue's scale from its 500 step. Tints mix toward white, shades toward black, in oklch (scss/_colors.scss).",
      "tint": {
        "025": 94,
        "050": 90,
        "100": 80,
        "200": 60,
        "300": 40,
        "400": 20
      },
      "shade": {
        "600": 16,
        "700": 32,
        "800": 48,
        "900": 64,
        "950": 70,
        "975": 76
      }
    }
  },
  "filmmakers": {
    "color": {
      "$type": "color",
      "primary": {
        "default": {
          "$value": "{bootstrap.color.blue.600}",
          "$description": "Used when a customer has not set a primary. Bootstrap's blue-500 fails 4.5:1 with white text; blue-600 passes (foundations/colour.md)."
        },
        "source": {
          "$value": "{filmmakers.color.primary.default}",
          "$description": "Set per customer at runtime. Every primary role derives from this one value.",
          "$extensions": {
            "com.denkungsart.filmmakers": {
              "perCustomer": true
            }
          }
        },
        "contrast": {
          "$value": "{bootstrap.color.white}",
          "$description": "Text and icons on primary. Not adjusted automatically; a failing customer primary is an ASK."
        },
        "roles": {
          "$description": "Every primary role derives from the source colour, as in the Component mapping prototypes.",
          "fg": {
            "$value": "{filmmakers.color.primary.source}"
          },
          "fg-emphasis": {
            "$value": "color-mix(in oklch, {filmmakers.color.primary.source} 78%, #000)"
          },
          "bg-subtle": {
            "$value": "color-mix(in oklch, {filmmakers.color.primary.source} 12%, #fff)"
          },
          "bg-muted": {
            "$value": "color-mix(in oklch, {filmmakers.color.primary.source} 26%, #fff)"
          },
          "border": {
            "$value": "color-mix(in oklch, {filmmakers.color.primary.source} 55%, #fff)"
          }
        }
      },
      "accent": {
        "client-zone": {
          "$value": "{bootstrap.color.orange.500}",
          "$description": "Marks areas that clients or other people outside the team can see. Chrome and context only, never actions."
        }
      },
      "always-blue": {
        "$description": "Never follows the customer primary.",
        "control-checked": {
          "$value": "{bootstrap.color.blue.600}"
        },
        "progress-bar": {
          "$value": "{bootstrap.color.blue.600}"
        },
        "focus-ring": {
          "$value": "color-mix(in oklch, {bootstrap.color.blue.500} 50%, #fff)"
        }
      }
    },
    "font": {
      "weight": {
        "$type": "fontWeight",
        "normal": {
          "$value": 400,
          "$description": "Body, table cells, input values"
        },
        "semibold": {
          "$value": 600,
          "$description": "Headings, buttons, labels, column headers, emphasis"
        }
      },
      "size": {
        "$type": "dimension",
        "h1": {
          "$value": "1.875rem"
        },
        "h2": {
          "$value": "1.5rem"
        },
        "h3": {
          "$value": "1.25rem"
        },
        "h4": {
          "$value": "1.125rem"
        },
        "h5": {
          "$value": "1rem"
        },
        "h6": {
          "$value": "0.875rem"
        },
        "lead": {
          "$value": "1.125rem"
        },
        "body-lg": {
          "$value": "1rem",
          "$description": "Paragraphs people read"
        },
        "body": {
          "$value": "0.875rem",
          "$description": "Default. Anything people scan, operate or fill in"
        },
        "body-sm": {
          "$value": "0.8125rem",
          "$description": "Tooltips, dense cards and tables"
        },
        "caption": {
          "$value": "0.75rem",
          "$description": "Floor. Fine print only"
        }
      }
    }
  }
}
